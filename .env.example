# App URL (OAuth redirects, Stripe success/cancel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Identity Lock checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OAuth state signing (use a long random string in production)
OAUTH_STATE_SECRET=

# X (Twitter) OAuth 2 — monitoring only
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# TikTok Login Kit — monitoring only
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional: Wix REST probe when connecting sites (can also pass per-request)
WIX_API_TOKEN=

# Optional: registrar API (otherwise orders queue for manual fulfillment)
REGISTRAR_API_KEY=
REGISTRAR_PROVIDER=

# Optional: override vault data directory (default: ./data/vault)
# VAULT_DATA_DIR=
