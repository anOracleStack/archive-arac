# App URL (OAuth redirects, Stripe success/cancel)
# Production host: oidib.io — set this in Vercel/hosting for Production only.
# For local dev, use http://localhost:3000 (or your dev port) in .env.local instead.
NEXT_PUBLIC_APP_URL=https://oidib.io

# Stripe (Identity Lock checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OAuth state signing (use a long random string in production)
OAUTH_STATE_SECRET=

# X (Twitter) OAuth 2 — monitoring only
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# TikTok Login Kit — monitoring only
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional: Wix REST probe when connecting sites (can also pass per-request)
WIX_API_TOKEN=

# Optional: Namecheap reseller (otherwise orders queue for manual fulfillment)
REGISTRAR_PROVIDER=manual
REGISTRAR_API_KEY=
REGISTRAR_API_USER=
REGISTRAR_USERNAME=
NAMECHEAP_CLIENT_IP=
REGISTRAR_SANDBOX=false

# Vault storage (production on Vercel)
# Connect a Blob store to project "archive-arac" in Vercel → Storage → Create Blob.
# Vercel auto-injects BLOB_READ_WRITE_TOKEN — no manual copy needed when linked.
# Local dev without Blob uses ./data/vault on disk (ephemeral on serverless without Blob).
# BLOB_READ_WRITE_TOKEN=

# Optional: override vault data directory for local filesystem fallback
# VAULT_DATA_DIR=
